# Copy to ".env.local" (never commit .env.local). Restart `npm run dev` after changes.

# --- GitHub (PAT or fine-grained token: repo + workflow + issues as needed) ---
GITHUB_TOKEN=
# Optional: default branch for workflow_dispatch when UI does not send ref
GITHUB_DEFAULT_BRANCH=main

# --- Jira Cloud (API token: https://id.atlassian.com/manage-profile/security/api-tokens) ---
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# --- ServiceNow (instance host only, no https:// in SERVICENOW_INSTANCE) ---
# Use either OAuth access token OR username + password (basic).
SERVICENOW_INSTANCE=yourcompany.service-now.com
SERVICENOW_ACCESS_TOKEN=
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# --- Vulnerability intel (optional; OSV works without keys) ---
# NVD API 2.0 — higher rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- AI remediation (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Nexus API (future server-side; keys in UI are browser-simulated in this demo) ---
# NEXUS_API_ISSUER=
# NEXUS_JWKS_URL=

# --- Subscription gating (browser cookies; replace with JWT / billing webhooks in prod) ---
# aspm-modules=* | sast | sast,dast,sca | ...
# aspm-enforce-subscription=1 requires aspm-modules to be set (use /billing UI)
